# ── Flutter Environment Files ──────────────────────────────
# Copy to .env.development AND .env.production, then fill in values.
# Both files are gitignored – never commit real keys.
#
# After editing, regenerate:
#   dart run build_runner build --delete-conflicting-outputs
#
# Build mode mapping:
#   flutter run       → kDebugMode   → reads .env.development
#   flutter build ios → kReleaseMode → reads .env.production

